# Copy to mcp/.env (gitignored) and fill in to enable real external actions.
# The server loads this file automatically. Non-secret paths can also be passed
# via the .mcp.json "env" block instead.

# Who is credited as the human in the audit ledger (defaults to git user.name).
ACTOR_HUMAN=

# The Flutter app repo the MCP builds APKs from and opens PRs against.
APP_REPO_PATH=/Users/pavelsmirnov/projects/regagro/agro_system

# Telegram delivery (from @BotFather + getUpdates — see docs/SETUP.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: a GitHub token (usually `gh auth login` is enough instead).
GH_TOKEN=

# --- Network transport (shared server / claude.ai connector) -----------------
# Leave MCP_TRANSPORT unset (or =stdio) for local Claude Code over stdio.
# Set =sse to serve over HTTP so the server can be added to claude.ai as a
# custom connector. (streamable-http is also supported.)
MCP_TRANSPORT=
# Bind address/port of the MCP process itself (nginx terminates TLS in front).
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Secret required on the connection URL (?token=…) or as `Authorization: Bearer`.
# Without it the network transport runs UNGATED — always set one when public.
MCP_AUTH_TOKEN=
# Optional comma-separated Host allow-list (DNS-rebinding protection). Empty =>
# protection off; the token gate + TLS/nginx are the boundary.
MCP_ALLOWED_HOSTS=
