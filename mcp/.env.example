# Copy to mcp/.env (gitignored) and fill in to enable real external actions.
# The server loads this file automatically. Non-secret paths can also be passed
# via the .mcp.json "env" block instead.

# Who is credited as the human in the audit ledger (defaults to git user.name).
ACTOR_HUMAN=

# The app repo the MCP edits, builds APKs from, and opens PRs / releases against.
# Also holds the project's own sdlc/ tree — point SDLC_ROOT at it (see below).
APP_REPO_PATH=/root/lifestocks
# Default PR base branch (project-specific; else PRs target `develop`).
APP_BASE_BRANCH=develop_shz_rewirte
# Tree the engine operates on — the target project's sdlc/, not the platform's.
SDLC_ROOT=/root/lifestocks/sdlc
# Command app_test runs in the app repo (project-specific).
APP_TEST_CMD=flutter test

# GitHub token for PRs and Release uploads. A fine-grained PAT scoped to the app
# repo (Contents: RW, Pull requests: RW) is enough; gh reads GH_TOKEN from the
# environment, so `gh auth login` is not needed. See docs/SETUP.md §4.1.
GH_TOKEN=

# Telegram is NOT used for APK delivery (server may be unable to reach
# api.telegram.org, and a bot caps files at 50MB). APKs go to a GitHub Release
# (§4.2). These are left for completeness; leave blank.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Network transport (shared server / claude.ai connector) -----------------
# Leave MCP_TRANSPORT unset (or =stdio) for local Claude Code over stdio.
# Set =sse to serve over HTTP so the server can be added to claude.ai as a
# custom connector. (streamable-http is also supported.)
MCP_TRANSPORT=
# Bind address/port of the MCP process itself (nginx terminates TLS in front).
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Secret required on the connection URL (?token=…) or as `Authorization: Bearer`.
# Without it the network transport runs UNGATED — always set one when public.
MCP_AUTH_TOKEN=
# Optional comma-separated Host allow-list (DNS-rebinding protection). Empty =>
# protection off; the token gate + TLS/nginx are the boundary.
MCP_ALLOWED_HOSTS=
